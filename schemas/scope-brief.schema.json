{
  "$defs": {
    "ReviewType": {
      "enum": [
        "narrative",
        "critical",
        "technical"
      ],
      "title": "ReviewType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Scientific scope fields required before architecture competition.",
  "properties": {
    "evidence_feasibility": {
      "anyOf": [
        {
          "enum": [
            "feasible",
            "uncertain",
            "infeasible"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Feasibility"
    },
    "nearest_review_distinction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nearest Review Distinction"
    },
    "nearest_review_ids": {
      "items": {
        "type": "string"
      },
      "title": "Nearest Review Ids",
      "type": "array"
    },
    "proposed_contribution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Contribution"
    },
    "reader_decision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reader Decision"
    },
    "review_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_excludes": {
      "items": {
        "type": "string"
      },
      "title": "Scope Excludes",
      "type": "array"
    },
    "scope_includes": {
      "items": {
        "type": "string"
      },
      "title": "Scope Includes",
      "type": "array"
    },
    "target_readers": {
      "items": {
        "type": "string"
      },
      "title": "Target Readers",
      "type": "array"
    },
    "unresolved_problem": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unresolved Problem"
    }
  },
  "title": "ScopeBrief",
  "type": "object"
}
