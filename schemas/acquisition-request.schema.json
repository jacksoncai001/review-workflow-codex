{
  "$defs": {
    "AcquisitionPriority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ],
      "title": "AcquisitionPriority",
      "type": "string"
    },
    "AcquisitionRoute": {
      "enum": [
        "automatic_open",
        "operator_supply"
      ],
      "title": "AcquisitionRoute",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "access_basis": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Access Basis"
    },
    "affected_claim_ids": {
      "items": {
        "type": "string"
      },
      "title": "Affected Claim Ids",
      "type": "array"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "doi": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "evidence_type": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Evidence Type",
      "type": "string"
    },
    "landing_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Landing Url",
      "type": "string"
    },
    "license_or_terms": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Or Terms"
    },
    "pdf_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pdf Url"
    },
    "priority": {
      "$ref": "#/$defs/AcquisitionPriority"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 3,
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "resolution_note": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution Note"
    },
    "route": {
      "$ref": "#/$defs/AcquisitionRoute",
      "default": "operator_supply"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "default": "open",
      "pattern": "^(open|fulfilled|dismissed)$",
      "title": "Status",
      "type": "string"
    },
    "title": {
      "maxLength": 1000,
      "minLength": 3,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "maxLength": 255,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    },
    "year": {
      "anyOf": [
        {
          "maximum": 2200,
          "minimum": 1600,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    }
  },
  "required": [
    "request_id",
    "title",
    "landing_url",
    "priority",
    "reason",
    "evidence_type"
  ],
  "title": "AcquisitionRequest",
  "type": "object"
}
